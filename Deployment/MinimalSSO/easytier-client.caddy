@easytierNativeSSO path /.well-known/easytier-client /native/*
handle @easytierNativeSSO {
	reverse_proxy easytier-native-sso-sidecar:11212
}

# Keep every easytier-web route, API, asset, and OIDC callback on the unmodified
# upstream service. This handle must remain after the narrow sidecar matcher.
handle {
	reverse_proxy easytier-web:11211
}
